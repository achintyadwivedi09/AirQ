# Smart Air Pollution Monitoring Portal — .gitignore

# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.egg-info/
dist/
build/
.eggs/
venv/
.venv/
env/

# Environment / secrets — NEVER commit these
.env
*.env
!.env.example

# Data cache — auto-generated; can be rebuilt by running the backend
data/cache/

# Raw downloads — large files; download separately
data/raw/

# IDE
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# OS
.DS_Store
Thumbs.db
desktop.ini

# Jupyter
.ipynb_checkpoints/

# ML model files — large; track separately if needed
ml/models/*.pkl
ml/models/*.joblib

# Logs
*.log
